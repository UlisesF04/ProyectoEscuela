# Local Docker setup. Copy to .env.docker and fill the empty values.
# The Docker database uses its own volume, separate from PostgreSQL on your PC.
DB_NAME=proyecto_escuela
DB_USER=postgres
DB_PASSWORD=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Password for the four demo accounts (at least 8 characters).
DEMO_PASSWORD=
BACKEND_PORT=5000
FRONTEND_URL=http://localhost:5173

# Optional: real email notifications through Resend.
RESEND_API_KEY=
FROM_EMAIL=noreply@example.com
SERVICE_API_KEY=
AUSENCIA_UMBRAL=10
