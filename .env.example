# ─── Base de Datos (PostgreSQL) ──────────────────────────────────
# En Railway se usa DATABASE_URL directamente.
# En desarrollo local se usan las variables individuales.
DATABASE_URL=postgresql://user:pass@host:5432/db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# ─── Servidor Backend ───────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Frontend ───────────────────────────────────────────────────
FRONTEND_URL=https://your-frontend-domain.vercel.app

# ─── JWT ────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_random_64_char_secret

# ─── Resend (Email) ──────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
FROM_EMAIL=noreply@tu-escuela.edu

# ─── Almacenamiento de Archivos ─────────────────────────────────
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloudname

# ─── Agente de Notificaciones ───────────────────────────────────
SERVICE_API_KEY=sk-your-service-api-key-here
AUSENCIA_UMBRAL=10
