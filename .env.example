# ─── Base de Datos (PostgreSQL) ──────────────────────────────────
# En Railway se usa DATABASE_URL directamente.
# En desarrollo local se usan las variables individuales.
DATABASE_URL=postgresql://user:pass@host:5432/db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=proyecto_escuela
DB_USER=postgres
DB_PASSWORD=your_password_here

# ─── Servidor Backend ───────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Frontend ───────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── JWT ────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# ─── Resend (Email) ──────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
FROM_EMAIL=noreply@tu-escuela.edu

# ─── Almacenamiento de Archivos ─────────────────────────────────
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloudname

# ─── Agente de Notificaciones ───────────────────────────────────
SERVICE_API_KEY=sk-your-service-api-key-here
AUSENCIA_UMBRAL=10
