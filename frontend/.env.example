# Backend API URL (Vite exposes to client as import.meta.env.VITE_API_URL)
# In development with Vite proxy, this can be '/api/v1'
# In production, set to your actual API URL
VITE_API_URL=/api/v1

# Development proxy destination, without /api/v1. Match Docker's BACKEND_PORT.
VITE_PROXY_TARGET=http://localhost:5000
