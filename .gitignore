# =============================================================================
# ProyectoEscuela — .gitignore raíz
# =============================================================================

# --- Entorno Virtual Python (raíz) ---
venv/
.venv/
env/
.env/

# --- Node.js ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Build output ---
dist/
dist-ssr/
build/

# --- Environment files ---
.env
.env.local
.env.*.local

# --- Logs ---
*.log

# --- OS files ---
.DS_Store
Thumbs.db

# --- IDE ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- OpenSpec archived changes ---
openspec/changes/archive/

# --- Python cache ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
*.egg
