# ─── Base de Datos (PostgreSQL) ──────────────────────────────────
# En Railway se usa DATABASE_URL directamente.
# En desarrollo local se usan las variables individuales.
# Dejar DATABASE_URL vacío para usar DB_*; una URL configurada tiene prioridad.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# ─── Servidor Backend ───────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Frontend ───────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── JWT ────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_random_64_char_secret

# Contraseña requerida para crear las cuentas de prueba con db:seed:all.
DEMO_PASSWORD=
SEED_DEMO_DATA=false
# Solo activar explícitamente para adaptar un esquema local ya existente.
DB_SYNC_ALTER=false

# ─── Resend (Email) ──────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
FROM_EMAIL=noreply@tu-escuela.edu

# ─── Almacenamiento de Archivos ─────────────────────────────────
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloudname

# ─── Agente de Notificaciones ───────────────────────────────────
SERVICE_API_KEY=sk-your-service-api-key-here
AUSENCIA_UMBRAL=10
